{
  "name": "taskflow-desktop",
  "version": "2.1.0",
  "description": "TaskFlow - daily task timer",
  "main": "main.js",
  "author": "TaskFlow",
  "scripts": { "start": "electron ." },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.taskflow.desktop",
    "productName": "TaskFlow",
    "directories": { "buildResources": "." },
    "files": ["main.js", "preload.js", "wpreload.js", "widget.html", "index.html", "icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "TaskFlow-Setup-${version}.${ext}" },
    "portable": { "artifactName": "TaskFlow-Portable-${version}.${ext}" }
  }
}
