{
  "name": "taskflow-desktop",
  "version": "2.3.0",
  "description": "TaskFlow - daily task timer",
  "main": "main.js",
  "author": "TaskFlow",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.taskflow.desktop",
    "productName": "TaskFlow",
    "directories": {
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "wpreload.js",
      "widget.html",
      "index.html",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "artifactName": "TaskFlow-Setup-${version}.${ext}",
      "createStartMenuShortcut": true,
      "shortcutName": "TaskFlow",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "portable": {
      "artifactName": "TaskFlow-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}